<Window x:Class="SmartGreenhouse.App.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контракт операции" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding OperationName}" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Предусловия (Pre)" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PreConditions}" 
                               TextWrapping="Wrap" 
                               Margin="10" 
                               FontFamily="Consolas"/>
                </GroupBox>

                <GroupBox Header="Постусловия (Post)" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PostConditions}" 
                               TextWrapping="Wrap" 
                               Margin="10" 
                               FontFamily="Consolas"/>
                </GroupBox>

                <GroupBox Header="Эффекты и исключения" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Effects}" 
                               TextWrapping="Wrap" 
                               Margin="10" 
                               FontFamily="Consolas"/>
                </GroupBox>

                <GroupBox Header="Граничные примеры" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Валидный вход:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ValidExample}" 
                                   TextWrapping="Wrap" 
                                   FontFamily="Consolas" 
                                   Margin="10,0,0,10"
                                   Foreground="Green"/>
                        
                        <TextBlock Text="Невалидный вход:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding InvalidExample}" 
                                   TextWrapping="Wrap" 
                                   FontFamily="Consolas" 
                                   Margin="10,0,0,0"
                                   Foreground="Red"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" 
                Click="CloseButton_Click" 
                HorizontalAlignment="Right" 
                Padding="20,5" 
                Margin="0,15,0,0"/>
    </Grid>
</Window>


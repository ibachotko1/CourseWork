<Application x:Class="SmartGreenhouse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartGreenhouse.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Стили -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
        </Style>

        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- Конвертеры -->
        <local:BoolToColorConverter x:Key="BoolToColor"/>
        <local:BoolToTextConverter x:Key="BoolToText"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Application.Resources>
</Application>
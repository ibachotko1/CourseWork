<Window x:Class="SmartGreenhouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGreenhouse.App"
        mc:Ignorable="d"
        Title="Система управления умной теплицей" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Умная теплица - Панель управления" 
                   FontSize="20" FontWeight="Bold" Foreground="#1B5E20"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Основное содержимое -->
        <TabControl Grid.Row="1">
            <!-- Вкладка мониторинга -->
            <TabItem Header="Мониторинг">
                <ScrollViewer>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Данные датчиков -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                 Header="Данные с датчиков" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Температура:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentData.Temperature, StringFormat='{}{0}°C'}" 
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Влажность воздуха:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentData.Humidity, StringFormat='{}{0}%'}" 
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Влажность почвы:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentData.SoilMoisture, StringFormat='{}{0}%'}" 
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Уровень CO₂:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CurrentData.CO2Level, StringFormat='{}{0} ppm'}" 
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Освещенность:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CurrentData.LightIntensity, StringFormat='{}{0} lux'}" 
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Дождь:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" 
                                           Text="{Binding CurrentData.IsRaining, Converter={StaticResource BoolToVisibility}, ConverterParameter='reverse'}"
                                           Style="{StaticResource ValueTextStyle}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Время данных:" 
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentData.Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" 
                                           Style="{StaticResource ValueTextStyle}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Статус систем -->
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="Статус систем" Margin="0,0,5,10">
                            <StackPanel Margin="5">
                                <StackPanel.Resources>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Orientation" Value="Horizontal"/>
                                        <Setter Property="Margin" Value="0,5"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Border Background="{Binding Actuators.WaterValve, Converter={StaticResource BoolToColor}, ConverterParameter='Green|LightGray'}" 
                                        Style="{StaticResource StatusIndicatorStyle}"/>
                                <TextBlock Text="Полив" Style="{StaticResource ValueTextStyle}"/>

                                <Border Background="{Binding Actuators.Heater, Converter={StaticResource BoolToColor}, ConverterParameter='Orange|LightGray'}" 
                                        Style="{StaticResource StatusIndicatorStyle}"/>
                                <TextBlock Text="Обогрев" Style="{StaticResource ValueTextStyle}"/>

                                <Border Background="{Binding Actuators.Ventilation, Converter={StaticResource BoolToColor}, ConverterParameter='Blue|LightGray'}" 
                                        Style="{StaticResource StatusIndicatorStyle}"/>
                                <TextBlock Text="Вентиляция" Style="{StaticResource ValueTextStyle}"/>

                                <Border Background="{Binding Actuators.Lights, Converter={StaticResource BoolToColor}, ConverterParameter='Yellow|LightGray'}" 
                                        Style="{StaticResource StatusIndicatorStyle}"/>
                                <TextBlock Text="Освещение" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Булева логика -->
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Логика принятия решений" Margin="5,0,0,10">
                            <StackPanel Margin="5">
                                <TextBlock Text="Активные решения:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,5,0"
                                        Background="{Binding ShouldWater, Converter={StaticResource BoolToColor}, ConverterParameter='Green|LightGray'}"/>
                                    <TextBlock Text="Включить полив" Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,5,0"
                                        Background="{Binding ShouldHeat, Converter={StaticResource BoolToColor}, ConverterParameter='Orange|LightGray'}"/>
                                    <TextBlock Text="Включить обогрев" Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,5,0"
                                        Background="{Binding ShouldVentilate, Converter={StaticResource BoolToColor}, ConverterParameter='Blue|LightGray'}"/>
                                    <TextBlock Text="Включить вентиляцию" Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,5,0"
                                        Background="{Binding ShouldLight, Converter={StaticResource BoolToColor}, ConverterParameter='Yellow|LightGray'}"/>
                                    <TextBlock Text="Включить освещение" Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <Button Content="Анализ таблицы истинности" Command="{Binding AnalyzeTruthTableCommand}"
                                        Margin="0,10,0,0" Padding="10,5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- История данных -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="История данных">
                            <DataGrid ItemsSource="{Binding SensorHistory}" AutoGenerateColumns="True"
                                     MaxHeight="200" Margin="5"/>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка управления -->
            <TabItem Header="Управление">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Ручное управление -->
                    <GroupBox Grid.Row="0" Header="Ручное управление системами">
                        <UniformGrid Columns="3" Margin="10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Полив" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <ToggleButton Content="{Binding Actuators.WaterValve, Converter={StaticResource BoolToText}, ConverterParameter='Выкл|Вкл'}"
                                              IsChecked="{Binding Actuators.WaterValve}"
                                              Command="{Binding ToggleWaterCommand}" Padding="10,5"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Обогрев" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <ToggleButton Content="{Binding Actuators.Heater, Converter={StaticResource BoolToText}, ConverterParameter='Выкл|Вкл'}"
                                              IsChecked="{Binding Actuators.Heater}"
                                              Command="{Binding ToggleHeatingCommand}" Padding="10,5"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Вентиляция" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <ToggleButton Content="{Binding Actuators.Ventilation, Converter={StaticResource BoolToText}, ConverterParameter='Выкл|Вкл'}"
                                              IsChecked="{Binding Actuators.Ventilation}"
                                              Command="{Binding ToggleVentilationCommand}" Padding="10,5"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Освещение" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <ToggleButton Content="{Binding Actuators.Lights, Converter={StaticResource BoolToText}, ConverterParameter='Выкл|Вкл'}"
                                              IsChecked="{Binding Actuators.Lights}"
                                              Command="{Binding ToggleLightingCommand}" Padding="10,5"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Защита от солнца" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <ToggleButton Content="{Binding Actuators.SunProtection, Converter={StaticResource BoolToText}, ConverterParameter='Выкл|Вкл'}"
                                              IsChecked="{Binding Actuators.SunProtection}"
                                              Command="{Binding ToggleSunProtectionCommand}" Padding="10,5"/>
                            </StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <!-- Автоматическое управление -->
                    <GroupBox Grid.Row="1" Header="Автоматическое управление" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <CheckBox Content="Автоматический режим" IsChecked="{Binding IsAutoMode}"
                                     FontWeight="Bold" Margin="0,0,0,10"/>

                            <Button Content="Выполнить цикл обработки данных" 
                                    Command="{Binding ProcessDataCommand}"
                                    Padding="15,8" FontSize="12" Margin="0,5"/>

                            <Button Content="Запустить все системы" 
                                    Command="{Binding RunAllSystemsCommand}"
                                    Padding="15,8" FontSize="12" Margin="0,5"/>

                            <Button Content="Остановить все системы" 
                                    Command="{Binding StopAllSystemsCommand}"
                                    Padding="15,8" FontSize="12" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Логи операций -->
                    <GroupBox Grid.Row="2" Header="Лог операций" Margin="0,10,0,0">
                        <TextBox Text="{Binding OperationLog}" IsReadOnly="True" 
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="10" Margin="5"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Вкладка лабораторных работ -->
            <TabItem Header="Лабораторные работы">
                <TabControl Margin="10">
                    <TabItem Header="ЛР1: Контракты">
                        <ScrollViewer>
                            <StackPanel Margin="10">
                                <TextBlock Text="Операции с проверкой предусловий и постусловий:" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>

                                <Button Content="Проверить контракты полива" Command="{Binding CheckIrrigationContractsCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Проверить контракты обогрева" Command="{Binding CheckHeatingContractsCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Проверить контракты вентиляции" Command="{Binding CheckVentilationContractsCommand}"
                                        Padding="10,5" Margin="0,5"/>

                                <TextBlock Text="{Binding ContractsResult}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="ЛР2: WP-калькулятор">
                        <ScrollViewer>
                            <StackPanel Margin="10">
                                <TextBlock Text="Слабейшее предусловие для операций:" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>

                                <Button Content="Рассчитать WP для полива" Command="{Binding CalculateWpCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Рассчитать WP для климат-контроля" Command="{Binding CalculateClimateWpCommand}"
                                        Padding="10,5" Margin="0,5"/>

                                <TextBlock Text="Результат WP:" Style="{StaticResource HeaderTextStyle}" Margin="0,10,0,5"/>
                                <TextBox Text="{Binding WpResult}" IsReadOnly="True" MinHeight="60" 
                                         TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="ЛР3: Инварианты">
                        <ScrollViewer>
                            <StackPanel Margin="10">
                                <TextBlock Text="Циклы с инвариантами и вариантами:" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>

                                <Button Content="Запустить цикл обработки данных" Command="{Binding RunDataProcessingCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Запустить цикл полива" Command="{Binding RunIrrigationCycleCommand}"
                                        Padding="10,5" Margin="0,5"/>

                                <TextBlock Text="{Binding InvariantResult}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="ЛР4: Булевы функции">
                        <ScrollViewer>
                            <StackPanel Margin="10">
                                <TextBlock Text="Булева логика и таблицы истинности:" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10"/>

                                <Button Content="Сгенерировать таблицу истинности" Command="{Binding GenerateTruthTableCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Анализ логики освещения" Command="{Binding AnalyzeLightingLogicCommand}"
                                        Padding="10,5" Margin="0,5"/>
                                <Button Content="Анализ корреляций" Command="{Binding AnalyzeCorrelationsCommand}"
                                        Padding="10,5" Margin="0,5"/>

                                <TextBlock Text="Результат:" Style="{StaticResource HeaderTextStyle}" Margin="0,10,0,5"/>
                                <TextBox Text="{Binding BooleanLogicResult}" IsReadOnly="True" MinHeight="100" 
                                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentTime, StringFormat='Время: {0:HH:mm:ss}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
<Window x:Class="SmartGreenhouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGreenhouse.App"
        xmlns:invariants="clr-namespace:SmartGreenhouse.Core.Invariants;assembly=SmartGreenhouse.Core"
        mc:Ignorable="d"
        Title="Система управления умной теплицей" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Умная теплица - Панель управления" 
                   FontSize="20" FontWeight="Bold" Foreground="#1B5E20"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Основное содержимое -->
        <TabControl Grid.Row="1">
            <!-- Вкладка мониторинга -->
            <TabItem Header="Мониторинг">
                <ScrollViewer>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Данные датчиков -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                 Header="Данные с датчиков" Margin="0,0,0,10">
                            <UniformGrid Columns="3" Rows="2" Margin="10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Температура:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.Temperature, StringFormat='{}{0}°C'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Влажность воздуха:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.Humidity, StringFormat='{}{0}%'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Влажность почвы:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.SoilMoisture, StringFormat='{}{0}%'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Уровень CO₂:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.CO2Level, StringFormat='{}{0} ppm'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Освещенность:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.LightIntensity, StringFormat='{}{0} lux'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Справка -->
                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Справка" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Нормальные значения (система не принимает решений):" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="• Температура: 15-25°C" 
                                           Style="{StaticResource ValueTextStyle}" Margin="10,2,0,2"/>
                                <TextBlock Text="• Влажность воздуха: 50-70%" 
                                           Style="{StaticResource ValueTextStyle}" Margin="10,2,0,2"/>
                                <TextBlock Text="• Влажность почвы: 60-70%" 
                                           Style="{StaticResource ValueTextStyle}" Margin="10,2,0,2"/>
                                <TextBlock Text="• Уровень CO₂: 1000-1200 ppm" 
                                           Style="{StaticResource ValueTextStyle}" Margin="10,2,0,2"/>
                                <TextBlock Text="• Освещенность: 3000-5000 lux" 
                                           Style="{StaticResource ValueTextStyle}" Margin="10,2,0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- История данных -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="История данных">
                            <StackPanel Margin="5">
                                <Button Content="Открыть график параметров" Command="{Binding OpenChartCommand}"
                                        HorizontalAlignment="Right" Margin="0,0,0,5" Padding="10,5"/>
                                <DataGrid ItemsSource="{Binding SensorHistory}" AutoGenerateColumns="False"
                                         MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Температура, °C" Binding="{Binding Temperature, StringFormat='{}{0:F1}'}" Width="*"/>
                                        <DataGridTextColumn Header="Влажность воздуха, %" Binding="{Binding Humidity, StringFormat='{}{0:F1}'}" Width="*"/>
                                        <DataGridTextColumn Header="Влажность почвы, %" Binding="{Binding SoilMoisture, StringFormat='{}{0:F1}'}" Width="*"/>
                                        <DataGridTextColumn Header="Уровень CO₂, ppm" Binding="{Binding CO2Level, StringFormat='{}{0:F0}'}" Width="*"/>
                                        <DataGridTextColumn Header="Освещенность, lux" Binding="{Binding LightIntensity, StringFormat='{}{0:F0}'}" Width="*"/>
                                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ЛР1: Контракты -->
            <TabItem Header="ЛР1: Контракты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель ввода параметров -->
                    <GroupBox Grid.Row="0" Header="Параметры ввода" Margin="0,0,0,10">
                        <UniformGrid Columns="4" Margin="10">
                            <StackPanel Margin="5">
                                <TextBlock Text="Температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputTemperature, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Влажность почвы, %:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputSoilMoisture, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Уровень CO₂, ppm:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputCO2Level, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Освещенность, lux:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputLightIntensity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <!-- Общие кнопки -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <Button Content="Выполнить все операции" 
                                Command="{Binding ExecuteAllOperationsCommand}"
                                Padding="20,8" 
                                FontSize="14" 
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>
                        <Button Content="Показать контракт" 
                                Command="{Binding ShowAllContractsCommand}"
                                Padding="20,8" 
                                FontSize="14"
                                FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Результаты операций -->
                    <GroupBox Grid.Row="2" Header="Результаты проверки операций">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OperationResults}" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,10" Padding="10" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding OperationName}" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <TextBlock Text="Предусловия:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                    <TextBlock Text="{Binding PreConditionsDescription}" 
                                                               TextWrapping="Wrap" 
                                                               FontSize="10" 
                                                               Margin="10,0,0,5"/>
                                                    <TextBlock Text="Постусловия:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                    <TextBlock Text="{Binding PostConditionsDescription}" 
                                                               TextWrapping="Wrap" 
                                                               FontSize="10" 
                                                               Margin="10,0,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="Pre" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <Ellipse Width="25" Height="25" 
                                                             Fill="{Binding PreConditionColor}" 
                                                             Stroke="Black" 
                                                             StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding PreConditionMet, StringFormat='{}{0}'}" 
                                                               HorizontalAlignment="Center" 
                                                               Margin="0,3,0,0" FontSize="9"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="Post" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <Ellipse Width="25" Height="25" 
                                                             Fill="{Binding PostConditionColor}" 
                                                             Stroke="Black" 
                                                             StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding PostConditionMet, StringFormat='{}{0}'}" 
                                                               HorizontalAlignment="Center" 
                                                               Margin="0,3,0,0" FontSize="9"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ЛР2: WP-калькулятор -->
            <TabItem Header="ЛР2: WP-калькулятор">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Выбор примера -->
                    <GroupBox Grid.Row="0" Header="Пример операции" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ComboBox ItemsSource="{Binding WpExamples}" 
                                      SelectedItem="{Binding SelectedWpExample}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Выберите пример операции теплицы или используйте свой код" 
                                       FontSize="10" 
                                       Foreground="Gray"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Цель (Post) -->
                    <GroupBox Grid.Row="1" Header="Цель (Post)" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Краткая запись:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding WpPostCondition}" 
                                         FontFamily="Consolas" 
                                         FontSize="11"
                                         MinHeight="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Человеческим языком:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding WpPostConditionDescription}" 
                                         FontSize="11"
                                         MinHeight="30"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Редактор кода -->
                    <GroupBox Grid.Row="2" Header="Редактор кода фрагмента" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Поддерживаемые операторы: присваивание (x := expr), ветвление (if (B) { S1 } else { S2 }), последовательность" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding WpCode}" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas" 
                                     FontSize="11"
                                     MinHeight="120"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Рассчитать WP" 
                                    Command="{Binding CalculateWpCommand}"
                                    Padding="15,8" 
                                    FontSize="12" 
                                    FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Результаты -->
                    <GroupBox Grid.Row="3" Header="Результаты расчета WP">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Пошаговый трейс -->
                            <GroupBox Grid.Row="0" Header="Пошаговый трейс" Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                    <TextBlock Text="{Binding WpTrace}" 
                                               TextWrapping="Wrap" 
                                               FontFamily="Consolas" 
                                               FontSize="10" 
                                               Margin="5"/>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- Итоговое предусловие -->
                            <GroupBox Grid.Row="1" Header="Итоговое предусловие (WP)" Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Краткая запись:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding WpFinalResult}" 
                                                   FontFamily="Consolas" 
                                                   FontSize="11" 
                                                   Margin="10,0,0,10"/>
                                        <TextBlock Text="Расшифровка:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding WpFinalResultDescription}" 
                                                   FontSize="11" 
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- Кнопка показать триаду -->
                            <Button Grid.Row="2" Content="Показать триаду" 
                                    Command="{Binding ShowWpTriadCommand}"
                                    Padding="15,8" 
                                    FontSize="12"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ЛР3: Инварианты -->
            <TabItem Header="ЛР3: Инварианты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- Панель данных -->
                    <GroupBox Grid.Row="0" Header="Данные" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Количество измерений:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Мин. температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Макс. температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataMax, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Критический порог, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>

                            <Button Grid.Row="1" Content="Сгенерировать данные датчиков температуры" 
                                    Command="{Binding GenerateLoopDataCommand}"
                                    Padding="15,8" FontSize="12" FontWeight="Bold"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding LoopDataTable}" 
                                      AutoGenerateColumns="False" 
                                      MaxHeight="200"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" Width="80"/>
                                    <DataGridTextColumn Header="Температура, °C" Binding="{Binding Value, StringFormat='{}{0:F2}'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- Режимы -->
                    <GroupBox Grid.Row="1" Header="Режимы" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Режим:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding SelectedLoopMode}" 
                                      ItemsSource="{Binding AvailableLoopModes}" 
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Режимы: Сумма температур (для среднего) / Подсчет критических моментов (температура &lt; 15°C, включение обогревателей) / Максимальная температура" 
                                       FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Блок инвариант/вариант -->
                    <GroupBox Grid.Row="2" Header="Инвариант и Вариант-функция" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Инвариант (словами):" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding InvariantDescription}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Инвариант (формула):" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding InvariantFormula}" 
                                       FontFamily="Consolas" 
                                       FontSize="11"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Вариант-функция t:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding VariantFunction}" 
                                       FontFamily="Consolas" 
                                       FontSize="11"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Текущее значение t:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding VariantValue}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Проверка сохранения (wp) -->
                    <GroupBox Grid.Row="3" Header="Проверка сохранения (wp)" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Content="Проверить условия верификации (VC)" 
                                    Command="{Binding CheckVerificationConditionsCommand}"
                                    Padding="15,8" FontSize="12" FontWeight="Bold"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBlock Text="{Binding VerificationConditions}" 
                                           TextWrapping="Wrap" 
                                           FontFamily="Consolas" 
                                           FontSize="10"/>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- Кнопка выполнения -->
                    <GroupBox Grid.Row="4" Header="Выполнение" Margin="0,10,0,10">
                        <StackPanel Margin="10">
                            <Button Content="Выполнить обработку данных" 
                                    Command="{Binding ExecuteLoopAndShowResultCommand}"
                                    Padding="20,10" FontSize="14" FontWeight="Bold"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Результат -->
                    <GroupBox Grid.Row="5" Header="Результат" Margin="0,0,0,10">
                        <TextBlock Text="{Binding InvariantResult}" 
                                   TextWrapping="Wrap" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="10"/>
                    </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ЛР4: Булевы функции -->
            <TabItem Header="ЛР4: Булевы функции">
                <TabControl>
                    <!-- Вкладка со справкой -->
                    <TabItem Header="Справка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15">
                                <TextBlock Text="Булевы функции в системе управления умной теплицей" 
                                           FontSize="18" FontWeight="Bold" 
                                           Foreground="#1B5E20" 
                                           Margin="0,0,0,15"/>
                                
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,15">
                                    <Run Text="Система управления умной теплицей использует булевы функции для принятия решений о включении/выключении различных систем:" FontWeight="Bold"/>
                                </TextBlock>
                                
                                <GroupBox Header="Примеры булевых функций в теплице" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="1. Полив:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="   Формула: Низкая влажность почвы" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,10"/>
                                        <TextBlock Text="   x1 = (влажность почвы &lt; 60%)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="DarkBlue"
                                                   Margin="20,0,0,15"/>
                                        
                                        <TextBlock Text="2. Обогрев:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="   Формула: Низкая температура" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,10"/>
                                        <TextBlock Text="   x1 = (температура &lt; 15°C)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="DarkBlue"
                                                   Margin="20,0,0,15"/>
                                        
                                        <TextBlock Text="3. Вентиляция:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="   Формула: Высокая температура ИЛИ высокий CO₂" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,10"/>
                                        <TextBlock Text="   x1 | x2, где x1=(температура &gt; 25°C), x2=(CO₂ &gt; 1200 ppm)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="DarkBlue"
                                                   Margin="20,0,0,15"/>
                                        
                                        <TextBlock Text="4. Освещение:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="   Формула: Низкая освещенность ИЛИ (ночь И нужны саженцы)" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,10"/>
                                        <TextBlock Text="   x1 | (x2 &amp; x3), где x1=(освещенность &lt; 3000 lux), x2=ночь, x3=нужны саженцы" 
                                                   FontFamily="Consolas" 
                                                   Foreground="DarkBlue"
                                                   Margin="20,0,0,15"/>
                                        
                                        <TextBlock Text="5. Сложная логика (импликация):" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="   Если включен полив, то должна быть нормальная температура" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,10"/>
                                        <TextBlock Text="   x1 -&gt; x2, где x1=полив включен, x2=(температура &gt; 5°C)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="DarkBlue"
                                                   Margin="20,0,0,15"/>
                                    </StackPanel>
                                </GroupBox>
                                
                                <GroupBox Header="Зачем нужны таблицы истинности и DNF/KNF?" Margin="0,0,0,15">
                                    <StackPanel Margin="10">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                            <Run Text="• Таблица истинности" FontWeight="Bold"/> показывает все возможные комбинации условий и результат принятия решения
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                            <Run Text="• DNF (дизъюнктивная нормальная форма)" FontWeight="Bold"/> показывает все случаи, когда система должна включиться
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                            <Run Text="• KNF (конъюнктивная нормальная форма)" FontWeight="Bold"/> показывает все случаи, когда система должна быть выключена
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                            <Run Text="• Проверка эквивалентности" FontWeight="Bold"/> позволяет убедиться, что разные формулировки логики дают одинаковый результат
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                
                                <GroupBox Header="Примеры формул для тестирования">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Попробуйте эти формулы в вкладке 'По формуле':" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock Text="• (x1 | x2) -&gt; x3  (если высокая температура ИЛИ высокий CO₂, то включить вентиляцию)" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,5"/>
                                        <TextBlock Text="• x1 &amp; !x2  (низкая влажность почвы И полив не включен)" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,5"/>
                                        <TextBlock Text="• (x1 ^ x2) = x3  (исключающее ИЛИ: либо обогрев, либо вентиляция, но не оба)" 
                                                   FontFamily="Consolas" 
                                                   Margin="20,0,0,5"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Вкладка "По номеру" -->
                    <TabItem Header="По номеру">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод параметров -->
                                <GroupBox Grid.Row="0" Header="Параметры функции" Margin="0,0,0,10">
                                    <UniformGrid Columns="2" Margin="10">
                                        <StackPanel Margin="5">
                                            <TextBlock Text="Количество переменных (n):" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding BooleanN, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                                            <TextBlock Text="n ∈ [1..10]" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="Номер функции (num):" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding BooleanNum, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                                            <TextBlock Text="num ∈ [0..2^(2^n)−1]" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </GroupBox>

                                <!-- Пояснение -->
                                <GroupBox Grid.Row="1" Header="Пояснение" Margin="0,0,0,10">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Связь с теплицей:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Номер функции определяет логику принятия решений. Например, функция может описывать условия включения полива, обогрева или вентиляции на основе комбинаций показаний датчиков." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="10" 
                                                   Foreground="DarkGreen"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding BooleanNumberExplanation}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="Двоичное представление num длиной 2^n соответствует значениям функции на всех кортежах переменных (от младшего бита к старшему)." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="10" 
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопки действий -->
                                <GroupBox Grid.Row="2" Header="Действия" Margin="0,0,0,10">
                                    <UniformGrid Columns="3" Margin="10">
                                        <Button Content="Таблица истинности" 
                                                Command="{Binding BuildTruthTableFromNumberCommand}"
                                                Padding="15,8" 
                                                FontSize="12" 
                                                FontWeight="Bold"
                                                Margin="5"/>
                                        <Button Content="DNF" 
                                                Command="{Binding GenerateDNFFromNumberCommand}"
                                                Padding="15,8" 
                                                FontSize="12" 
                                                FontWeight="Bold"
                                                Margin="5"/>
                                        <Button Content="KNF" 
                                                Command="{Binding GenerateKNFFromNumberCommand}"
                                                Padding="15,8" 
                                                FontSize="12" 
                                                FontWeight="Bold"
                                                Margin="5"/>
                                    </UniformGrid>
                                </GroupBox>

                                <!-- Результаты -->
                                <GroupBox Grid.Row="3" Header="Результаты">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="Скопировать в буфер" 
                                                Command="{Binding CopyBooleanResultCommand}"
                                                HorizontalAlignment="Right"
                                                Padding="10,5"
                                                Margin="0,0,0,5"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding BooleanNumberResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="11"/>
                                        </ScrollViewer>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Вкладка "По формуле" -->
                    <TabItem Header="По формуле">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод формулы -->
                                <GroupBox Grid.Row="0" Header="Формула" Margin="0,0,0,10">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Введите булеву формулу (связь с теплицей):" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding BooleanFormula, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontFamily="Consolas" 
                                                 FontSize="12"
                                                 MinHeight="40"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Margin="0,0,0,5"/>
                                        <TextBlock Text="Операторы: !/not (отрицание), &amp;/and (конъюнкция), |/or (дизъюнкция), ^/xor (исключающее ИЛИ), -&gt; (импликация), = (эквивалентность)" 
                                                   FontSize="10" 
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"/>
                                        
                                        <!-- Кнопки с примерами формул для теплицы -->
                                        <TextBlock Text="Примеры формул для теплицы:" FontWeight="Bold" Margin="0,10,0,5"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,5">
                                            <Button Content="Вентиляция: (x1 | x2)" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="(x1 | x2)"
                                                    Padding="8,4"
                                                    FontSize="10"
                                                    Margin="2"/>
                                            <Button Content="Полив: x1 &amp; !x2" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="x1 &amp; !x2"
                                                    Padding="8,4"
                                                    FontSize="10"
                                                    Margin="2"/>
                                            <Button Content="Импликация: (x1 | x2) -&gt; x3" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="(x1 | x2) -&gt; x3"
                                                    Padding="8,4"
                                                    FontSize="10"
                                                    Margin="2"/>
                                        </UniformGrid>
                                        
                                        <TextBlock Text="Где: x1=высокая температура, x2=высокий CO₂, x3=включить вентиляцию" 
                                                   FontSize="9" 
                                                   Foreground="DarkGray"
                                                   FontStyle="Italic"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопка разбора -->
                                <GroupBox Grid.Row="1" Header="Действия" Margin="0,0,0,10">
                                    <StackPanel Margin="10">
                                        <Button Content="Разобрать и вычислить" 
                                                Command="{Binding ParseAndEvaluateFormulaCommand}"
                                                Padding="20,10" 
                                                FontSize="14" 
                                                FontWeight="Bold"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Информация о формуле -->
                                <GroupBox Grid.Row="2" Header="Информация о формуле" Margin="0,0,0,10">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding BooleanFormulaInfo}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding BooleanFormulaCost}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="DarkBlue"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Результаты -->
                                <GroupBox Grid.Row="3" Header="Результаты">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="Скопировать в буфер" 
                                                Command="{Binding CopyBooleanResultCommand}"
                                                HorizontalAlignment="Right"
                                                Padding="10,5"
                                                Margin="0,0,0,5"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding BooleanFormulaResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="11"/>
                                        </ScrollViewer>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Вкладка "Сравнение" -->
                    <TabItem Header="Сравнение">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод функций -->
                                <GroupBox Grid.Row="0" Header="Функции для сравнения" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                                        <TextBlock Text="Сравнение логики принятия решений:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Проверьте, эквивалентны ли две формулировки логики управления теплицей. Например, сравните прямую формулу с её DNF-представлением." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="10" 
                                                   Foreground="DarkGreen"
                                                   Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,0">
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Функция 1 (номер или формула):" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding BooleanCompareFunction1, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontFamily="Consolas" 
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Margin="0,0,0,5"/>
                                                <TextBlock Text="Пример: 11 или (x1 &amp; !x2) | x3" 
                                                           FontSize="9" 
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Функция 2 (номер или формула):" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding BooleanCompareFunction2, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontFamily="Consolas" 
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Margin="0,0,0,5"/>
                                                <TextBlock Text="Пример: DNF от функции 1" 
                                                           FontSize="9" 
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопка сравнения -->
                                <GroupBox Grid.Row="1" Header="Действия" Margin="0,0,0,10">
                                    <StackPanel Margin="10">
                                        <Button Content="Эквивалентны?" 
                                                Command="{Binding CheckEquivalenceCommand}"
                                                Padding="20,10" 
                                                FontSize="14" 
                                                FontWeight="Bold"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Результат сравнения -->
                                <GroupBox Grid.Row="2" Header="Результат сравнения">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="{Binding BooleanEquivalenceResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentTime, StringFormat='Время: {0:HH:mm:ss}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
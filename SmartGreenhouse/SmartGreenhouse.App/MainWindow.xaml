<Window x:Class="SmartGreenhouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartGreenhouse.App"
        xmlns:invariants="clr-namespace:SmartGreenhouse.Core.Invariants;assembly=SmartGreenhouse.Core"
        mc:Ignorable="d"
        Title="Система управления умной теплицей" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="10" Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Умная теплица - Панель управления" 
                   Style="{StaticResource TitleTextStyle}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Основное содержимое -->
        <TabControl Grid.Row="1">
            <!-- Вкладка мониторинга -->
            <TabItem Header="Мониторинг">
                <ScrollViewer Background="{StaticResource BackgroundColor}">
                    <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Статусы систем управления -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                 Header="Статус систем управления">
                            <UniformGrid Columns="5" Rows="1" Margin="8">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Полив:" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{Binding Actuators.WaterValve, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}" 
                                                 Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Text="{Binding Actuators.WaterValve, Converter={StaticResource BoolToText}, ConverterParameter='Не работает|Работает'}" 
                                                   Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="4">
                                    <TextBlock Text="Обогрев:" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{Binding Actuators.Heater, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}" 
                                                 Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Text="{Binding Actuators.Heater, Converter={StaticResource BoolToText}, ConverterParameter='Не работает|Работает'}" 
                                                   Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="4">
                                    <TextBlock Text="Вентиляция:" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{Binding Actuators.Ventilation, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}" 
                                                 Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Text="{Binding Actuators.Ventilation, Converter={StaticResource BoolToText}, ConverterParameter='Не работает|Работает'}" 
                                                   Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="4">
                                    <TextBlock Text="Освещение:" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{Binding Actuators.Lights, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}" 
                                                 Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Text="{Binding Actuators.Lights, Converter={StaticResource BoolToText}, ConverterParameter='Не работает|Работает'}" 
                                                   Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="4">
                                    <TextBlock Text="Защита от солнца:" Style="{StaticResource HeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{Binding Actuators.SunProtection, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}" 
                                                 Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Text="{Binding Actuators.SunProtection, Converter={StaticResource BoolToText}, ConverterParameter='Не работает|Работает'}" 
                                                   Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Данные датчиков -->
                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                 Header="Данные с датчиков">
                            <UniformGrid Columns="3" Rows="2" Margin="8">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Температура:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.Temperature, StringFormat='{}{0}°C'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Влажность воздуха:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.Humidity, StringFormat='{}{0}%'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Влажность почвы:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.SoilMoisture, StringFormat='{}{0}%'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Уровень CO₂:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.CO2Level, StringFormat='{}{0} ppm'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Освещенность:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBlock Text="{Binding CurrentData.LightIntensity, StringFormat='{}{0} lux'}" 
                                               Style="{StaticResource ValueTextStyle}"/>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Справка -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Справка">
                            <StackPanel Margin="8">
                                <TextBlock Text="Нормальные значения (система не принимает решений):" 
                                           Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="• Температура: 15-25°C" 
                                           Style="{StaticResource ValueTextStyle}" Margin="12,4,0,4"/>
                                <TextBlock Text="• Влажность воздуха: 50-70%" 
                                           Style="{StaticResource ValueTextStyle}" Margin="12,4,0,4"/>
                                <TextBlock Text="• Влажность почвы: 60-70%" 
                                           Style="{StaticResource ValueTextStyle}" Margin="12,4,0,4"/>
                                <TextBlock Text="• Уровень CO₂: 1000-1200 ppm" 
                                           Style="{StaticResource ValueTextStyle}" Margin="12,4,0,4"/>
                                <TextBlock Text="• Освещенность: 3000-5000 lux" 
                                           Style="{StaticResource ValueTextStyle}" Margin="12,4,0,4"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- История данных -->
                        <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="История данных">
                            <StackPanel Margin="5">
                                <Button Content="Открыть график параметров" Command="{Binding OpenChartCommand}"
                                        HorizontalAlignment="Right" Margin="0,0,0,5" Padding="10,5"/>
                                <DataGrid ItemsSource="{Binding SensorHistory}" AutoGenerateColumns="False"
                                         MaxHeight="200" CanUserResizeColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Температура, °C" Binding="{Binding Temperature, StringFormat='{}{0:F1}'}" Width="120"/>
                                        <DataGridTextColumn Header="Влажность воздуха, %" Binding="{Binding Humidity, StringFormat='{}{0:F1}'}" Width="140"/>
                                        <DataGridTextColumn Header="Влажность почвы, %" Binding="{Binding SoilMoisture, StringFormat='{}{0:F1}'}" Width="130"/>
                                        <DataGridTextColumn Header="Уровень CO₂, ppm" Binding="{Binding CO2Level, StringFormat='{}{0:F0}'}" Width="120"/>
                                        <DataGridTextColumn Header="Освещенность, lux" Binding="{Binding LightIntensity, StringFormat='{}{0:F0}'}" Width="130"/>
                                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка управления -->
            <TabItem Header="Управление">
                <ScrollViewer Background="{StaticResource BackgroundColor}">
                    <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Ручное управление системами -->
                        <GroupBox Grid.Row="0" Header="Ручное управление системами">
                            <UniformGrid Columns="3" Rows="2" Margin="8">
                                <Button Content="Полив: ВКЛ/ВЫКЛ" 
                                        Command="{Binding ToggleWaterCommand}"
                                        Background="{Binding Actuators.WaterValve, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}"/>
                                
                                <Button Content="Обогрев: ВКЛ/ВЫКЛ" 
                                        Command="{Binding ToggleHeatingCommand}"
                                        Background="{Binding Actuators.Heater, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}"/>
                                
                                <Button Content="Вентиляция: ВКЛ/ВЫКЛ" 
                                        Command="{Binding ToggleVentilationCommand}"
                                        Background="{Binding Actuators.Ventilation, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}"/>
                                
                                <Button Content="Освещение: ВКЛ/ВЫКЛ" 
                                        Command="{Binding ToggleLightingCommand}"
                                        Background="{Binding Actuators.Lights, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}"/>
                                
                                <Button Content="Защита от солнца: ВКЛ/ВЫКЛ" 
                                        Command="{Binding ToggleSunProtectionCommand}"
                                        Background="{Binding Actuators.SunProtection, Converter={StaticResource BoolToColor}, ConverterParameter='#4CAF50|#F44336'}"/>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Автоматическое управление -->
                        <GroupBox Grid.Row="1" Header="Автоматическое управление">
                            <UniformGrid Columns="3" Margin="8">
                                <Button Content="Запустить все системы" 
                                        Command="{Binding RunAllSystemsCommand}"
                                        Background="#4CAF50"/>
                                
                                <Button Content="Остановить все системы" 
                                        Command="{Binding StopAllSystemsCommand}"
                                        Background="#F44336"/>
                                
                                <Button Content="Обработать данные датчиков" 
                                        Command="{Binding ProcessDataCommand}"
                                        Background="#2196F3"/>
                            </UniformGrid>
                        </GroupBox>

                        <!-- Лог операций -->
                        <GroupBox Grid.Row="2" Header="Лог операций">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <TextBlock Text="{Binding OperationLog}" 
                                           TextWrapping="Wrap" 
                                           FontFamily="Consolas" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           Margin="8"/>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Лабораторные работы -->
            <TabItem Header="Лабораторные работы">
                <TabControl>
                    <!-- ЛР1: Контракты -->
                    <TabItem Header="ЛР1: Контракты">
                <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Пояснение о контрактах -->
                    <GroupBox Grid.Row="0" Header="О лабораторной работе">
                        <StackPanel Margin="8">
                            <TextBlock Text="Контракты программ (Design by Contract)" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}" 
                                       Margin="0,0,0,6">
                                <Run Text="Контракт - это соглашение, которое описывает, что должно быть истинно ДО и ПОСЛЕ выполнения операции."/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,6">
                                • <Run FontWeight="SemiBold" Text="Предусловия (Pre)"/>: условия, которые должны быть выполнены ДО начала операции. Если они не выполнены, операцию нельзя выполнять.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,6">
                                • <Run FontWeight="SemiBold" Text="Постусловия (Post)"/>: условия, которые должны стать истинными ПОСЛЕ выполнения операции. Если они не выполнены, в операции ошибка.
                            </TextBlock>
                                    <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontStyle="Italic">
                                    </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель ввода параметров -->
                    <GroupBox Grid.Row="1" Header="Параметры ввода">
                        <UniformGrid Columns="4" Margin="8">
                            <StackPanel Margin="5">
                                <TextBlock Text="Температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputTemperature, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Влажность почвы, %:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputSoilMoisture, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Уровень CO₂, ppm:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputCO2Level, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>

                            <StackPanel Margin="5">
                                <TextBlock Text="Освещенность, lux:" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox Text="{Binding InputLightIntensity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5"/>
                            </StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <!-- Общие кнопки -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Выполнить все операции" 
                                Command="{Binding ExecuteAllOperationsCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Показать контракт" 
                                Command="{Binding ShowAllContractsCommand}"/>
                    </StackPanel>

                    <!-- Результаты операций -->
                    <GroupBox Grid.Row="3" Header="Результаты проверки операций">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OperationResults}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,8" Padding="12" Background="{StaticResource SurfaceColor}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding OperationName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,6"/>
                                                    <TextBlock Text="Предусловия:" Style="{StaticResource HeaderTextStyle}" Margin="0,4,0,2"/>
                                                    <TextBlock Text="{Binding PreConditionsDescription}" 
                                                               TextWrapping="Wrap" 
                                                               FontSize="11" 
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               Margin="12,0,0,6"/>
                                                    <TextBlock Text="Постусловия:" Style="{StaticResource HeaderTextStyle}" Margin="0,4,0,2"/>
                                                    <TextBlock Text="{Binding PostConditionsDescription}" 
                                                               TextWrapping="Wrap" 
                                                               FontSize="11" 
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               Margin="12,0,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="Pre" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,6"/>
                                                    <Ellipse Width="24" Height="24" 
                                                             Fill="{Binding PreConditionColor}" 
                                                             Stroke="{StaticResource BorderColor}" 
                                                             StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding PreConditionMet, StringFormat='{}{0}'}" 
                                                               HorizontalAlignment="Center" 
                                                               Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryColor}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="Post" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,6"/>
                                                    <Ellipse Width="24" Height="24" 
                                                             Fill="{Binding PostConditionColor}" 
                                                             Stroke="{StaticResource BorderColor}" 
                                                             StrokeThickness="1"/>
                                                    <TextBlock Text="{Binding PostConditionMet, StringFormat='{}{0}'}" 
                                                               HorizontalAlignment="Center" 
                                                               Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryColor}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ЛР2: WP-калькулятор -->
            <TabItem Header="ЛР2: WP-калькулятор">
                <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Пояснение о WP -->
                    <GroupBox Grid.Row="0" Header="О лабораторной работе">
                        <StackPanel Margin="8">
                            <TextBlock Text="Слабейшее предусловие (Weakest Precondition - WP)" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}" 
                                       Margin="0,0,0,6">
                                WP-калькулятор позволяет вычислить предусловия, необходимые для выполнения программы, двигаясь от постусловия (цели) к началу.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,6">
                                <Run FontWeight="SemiBold" Text="Правила вычисления:"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                • <Run FontWeight="SemiBold" Text="Присваивание"/>: wp(x := e, R) = R[x/e] (заменяем x на e в R)
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                • <Run FontWeight="SemiBold" Text="Условный оператор"/>: wp(if B then S₁ else S₂, R) = (B ∧ wp(S₁,R)) ∨ (¬B ∧ wp(S₂,R))
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                • <Run FontWeight="SemiBold" Text="Последовательность"/>: wp(S₁; S₂, R) = wp(S₁, wp(S₂, R)) (справа налево)
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0">
                                Пример: для кода "x := 5" с постусловием "x > 0" предусловием будет "5 > 0" (истина).
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <!-- Выбор примера -->
                    <GroupBox Grid.Row="1" Header="Пример операции">
                        <StackPanel Margin="8">
                            <ComboBox ItemsSource="{Binding WpExamples}" 
                                      SelectedItem="{Binding SelectedWpExample}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Выберите пример операции теплицы или используйте свой код" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Цель (Post) -->
                    <GroupBox Grid.Row="2" Header="Цель (Post)">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Краткая запись:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding WpPostCondition}" 
                                         FontFamily="Consolas" 
                                         FontSize="11"
                                         MinHeight="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Человеческим языком:" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding WpPostConditionDescription}" 
                                         FontSize="11"
                                         MinHeight="30"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Редактор кода -->
                    <GroupBox Grid.Row="3" Header="Редактор кода фрагмента">
                        <StackPanel Margin="8">
                            <TextBlock Text="Поддерживаемые операторы: присваивание (x := expr), ветвление (if (B) { S1 } else { S2 }), последовательность" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryColor}" 
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding WpCode}" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas" 
                                     FontSize="11"
                                     MinHeight="120"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Рассчитать WP" 
                                    Command="{Binding CalculateWpCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Результаты -->
                    <GroupBox Grid.Row="4" Header="Результаты расчета WP">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Пошаговый трейс -->
                            <GroupBox Grid.Row="0" Header="Пошаговый трейс">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                    <TextBlock Text="{Binding WpTrace}" 
                                               TextWrapping="Wrap" 
                                               FontFamily="Consolas" 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               Margin="8"/>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- Итоговое предусловие -->
                            <GroupBox Grid.Row="1" Header="Итоговое предусловие (WP)">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Краткая запись:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="{Binding WpFinalResult}" 
                                                   FontFamily="Consolas" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,4,0,8"/>
                                        <TextBlock Text="Расшифровка:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="{Binding WpFinalResultDescription}" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,4,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- Кнопка показать триаду -->
                            <Button Grid.Row="2" Content="Показать триаду" 
                                    Command="{Binding ShowWpTriadCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ЛР3: Инварианты -->
            <TabItem Header="ЛР3: Инварианты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource BackgroundColor}">
                    <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- Пояснение об инвариантах -->
                    <GroupBox Grid.Row="0" Header="О лабораторной работе">
                        <StackPanel Margin="8">
                            <TextBlock Text="Инварианты и вариант-функции циклов" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}" 
                                       Margin="0,0,0,6">
                                <Run FontWeight="SemiBold" Text="Инвариант цикла"/> - это условие, которое остается истинным на каждой итерации цикла.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,6">
                                <Run FontWeight="SemiBold" Text="Вариант-функция t"/> - это выражение, которое монотонно убывает на каждой итерации, гарантируя завершение цикла.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,6">
                                <Run FontWeight="SemiBold" Text="Условия верификации (VC):"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                1. <Run FontWeight="SemiBold" Text="Pre ⇒ Inv"/> - предусловие влечет инвариант
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                2. <Run FontWeight="SemiBold" Text="(Inv ∧ B) ⇒ wp(S, Inv)"/> - инвариант сохраняется после тела цикла
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,4">
                                3. <Run FontWeight="SemiBold" Text="(Inv ∧ ¬B) ⇒ Post"/> - инвариант и выход из цикла влекут постусловие
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="12,0,0,6">
                                4. <Run FontWeight="SemiBold" Text="t' t"/> - вариант-функция убывает
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontStyle="Italic">
                                Пример: при подсчете суммы температур инвариант: "res = sum(temperature[0..j-1])", вариант: "t = n - j".
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель данных -->
                    <GroupBox Grid.Row="1" Header="Данные">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Количество измерений:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Мин. температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Макс. температура, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopDataMax, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Критический порог, °C:" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox Text="{Binding LoopThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>

                            <Button Grid.Row="1" Content="Сгенерировать данные датчиков температуры" 
                                    Command="{Binding GenerateLoopDataCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding LoopDataTable}" 
                                      AutoGenerateColumns="False" 
                                      MaxHeight="200"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" Width="80"/>
                                    <DataGridTextColumn Header="Температура, °C" Binding="{Binding Value, StringFormat='{}{0:F2}'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- Режимы -->
                    <GroupBox Grid.Row="2" Header="Режимы">
                        <StackPanel Margin="8">
                            <TextBlock Text="Режим:" Style="{StaticResource HeaderTextStyle}"/>
                            <ComboBox SelectedItem="{Binding SelectedLoopMode}" 
                                      ItemsSource="{Binding AvailableLoopModes}" 
                                      Margin="0,4,0,8"/>
                            <TextBlock Text="Режимы: Сумма температур (для среднего) / Подсчет критических моментов (температура &lt; 15°C, включение обогревателей) / Максимальная температура" 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Блок инвариант/вариант -->
                    <GroupBox Grid.Row="3" Header="Инвариант и Вариант-функция">
                        <StackPanel Margin="8">
                            <TextBlock Text="Инвариант (словами):" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBlock Text="{Binding InvariantDescription}" 
                                       TextWrapping="Wrap" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="Инвариант (формула):" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBlock Text="{Binding InvariantFormula}" 
                                       FontFamily="Consolas" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="Вариант-функция t:" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBlock Text="{Binding VariantFunction}" 
                                       FontFamily="Consolas" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,4,0,8"/>

                            <TextBlock Text="Текущее значение t:" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBlock Text="{Binding VariantValue}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Проверка сохранения (wp) -->
                    <GroupBox Grid.Row="4" Header="Проверка сохранения (wp)">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Content="Проверить условия верификации (VC)" 
                                    Command="{Binding CheckVerificationConditionsCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBlock Text="{Binding VerificationConditions}" 
                                           TextWrapping="Wrap" 
                                           FontFamily="Consolas" 
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           Margin="8"/>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- Кнопка выполнения -->
                    <GroupBox Grid.Row="5" Header="Выполнение">
                        <StackPanel Margin="8">
                            <Button Content="Выполнить обработку данных" 
                                    Command="{Binding ExecuteLoopAndShowResultCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Результат -->
                    <GroupBox Grid.Row="6" Header="Результат">
                        <TextBlock Text="{Binding InvariantResult}" 
                                   TextWrapping="Wrap" 
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="8"/>
                    </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

                    <!-- ЛР4: Булевы функции -->
                    <TabItem Header="ЛР4: Булевы функции">
                        <TabControl>
                            <!-- Вкладка со справкой -->
                            <TabItem Header="Справка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundColor}">
                            <StackPanel Margin="12" Background="{StaticResource BackgroundColor}">
                                <TextBlock Text="Булевы функции в системе управления умной теплицей" 
                                           FontSize="18" FontWeight="SemiBold" 
                                           Foreground="{StaticResource PrimaryDarkColor}" 
                                           Margin="0,0,0,12"/>
                                
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,12">
                                    <Run Text="Система управления умной теплицей использует булевы функции для принятия решений о включении/выключении различных систем:" FontWeight="SemiBold"/>
                                </TextBlock>
                                
                                <GroupBox Header="Примеры булевых функций в теплице">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="1. Полив:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="   Формула: Низкая влажность почвы" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,2,0,6"/>
                                        <TextBlock Text="   x1 = (влажность почвы &lt; 60%)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,12"/>
                                        
                                        <TextBlock Text="2. Обогрев:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="   Формула: Низкая температура" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,2,0,6"/>
                                        <TextBlock Text="   x1 = (температура &lt; 15°C)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,12"/>
                                        
                                        <TextBlock Text="3. Вентиляция:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="   Формула: Высокая температура ИЛИ высокий CO₂" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,2,0,6"/>
                                        <TextBlock Text="   x1 | x2, где x1=(температура &gt; 25°C), x2=(CO₂ &gt; 1200 ppm)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,12"/>
                                        
                                        <TextBlock Text="4. Освещение:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="   Формула: Низкая освещенность ИЛИ (ночь И нужны саженцы)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,2,0,6"/>
                                        <TextBlock Text="   x1 | (x2 &amp; x3), где x1=(освещенность &lt; 3000 lux), x2=ночь, x3=нужны саженцы" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,12"/>
                                        
                                        <TextBlock Text="5. Сложная логика (импликация):" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="   Если включен полив, то должна быть нормальная температура" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="12,2,0,6"/>
                                        <TextBlock Text="   x1 -&gt; x2, где x1=полив включен, x2=(температура &gt; 5°C)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,12"/>
                                    </StackPanel>
                                </GroupBox>
                                
                                <GroupBox Header="Зачем нужны таблицы истинности и DNF/KNF?">
                                    <StackPanel Margin="8">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8">
                                            <Run Text="• Таблица истинности" FontWeight="SemiBold"/> показывает все возможные комбинации условий и результат принятия решения
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8">
                                            <Run Text="• DNF (дизъюнктивная нормальная форма)" FontWeight="SemiBold"/> показывает все случаи, когда система должна включиться
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8">
                                            <Run Text="• KNF (конъюнктивная нормальная форма)" FontWeight="SemiBold"/> показывает все случаи, когда система должна быть выключена
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8">
                                            <Run Text="• Проверка эквивалентности" FontWeight="SemiBold"/> позволяет убедиться, что разные формулировки логики дают одинаковый результат
                                        </TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                
                                <GroupBox Header="Примеры формул для тестирования">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Попробуйте эти формулы в вкладке 'По формуле':" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,8"/>
                                        <TextBlock Text="• (x1 | x2) -&gt; x3  (если высокая температура ИЛИ высокий CO₂, то включить вентиляцию)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,4"/>
                                        <TextBlock Text="• x1 &amp; !x2  (низкая влажность почвы И полив не включен)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,4"/>
                                        <TextBlock Text="• (x1 ^ x2) = x3  (исключающее ИЛИ: либо обогрев, либо вентиляция, но не оба)" 
                                                   FontFamily="Consolas" 
                                                   Foreground="{StaticResource AccentColor}"
                                                   Margin="12,0,0,4"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            </ScrollViewer>
                            </TabItem>
                            <!-- Вкладка "По номеру" -->
                            <TabItem Header="По номеру">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundColor}">
                            <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод параметров -->
                                <GroupBox Grid.Row="0" Header="Параметры функции">
                                    <UniformGrid Columns="2" Margin="8">
                                        <StackPanel Margin="4">
                                            <TextBlock Text="Количество переменных (n):" Style="{StaticResource HeaderTextStyle}"/>
                                            <TextBox Text="{Binding BooleanN, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                                            <TextBlock Text="n ∈ [1..10]" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="Номер функции (num):" Style="{StaticResource HeaderTextStyle}"/>
                                            <TextBox Text="{Binding BooleanNum, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                                            <TextBlock Text="num ∈ [0..2^(2^n)−1]" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </GroupBox>

                                <!-- Пояснение -->
                                <GroupBox Grid.Row="1" Header="Пояснение">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Связь с теплицей:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="Номер функции определяет логику принятия решений. Например, функция может описывать условия включения полива, обогрева или вентиляции на основе комбинаций показаний датчиков." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   Margin="0,4,0,8"/>
                                        <TextBlock Text="{Binding BooleanNumberExplanation}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Двоичное представление num длиной 2^n соответствует значениям функции на всех кортежах переменных (от младшего бита к старшему)." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource TextSecondaryColor}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопки действий -->
                                <GroupBox Grid.Row="2" Header="Действия">
                                    <UniformGrid Columns="3" Margin="8">
                                        <Button Content="Таблица истинности" 
                                                Command="{Binding BuildTruthTableFromNumberCommand}"/>
                                        <Button Content="DNF" 
                                                Command="{Binding GenerateDNFFromNumberCommand}"/>
                                        <Button Content="KNF" 
                                                Command="{Binding GenerateKNFFromNumberCommand}"/>
                                    </UniformGrid>
                                </GroupBox>

                                <!-- Результаты -->
                                <GroupBox Grid.Row="3" Header="Результаты">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="Скопировать в буфер" 
                                                Command="{Binding CopyBooleanResultCommand}"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,8"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding BooleanNumberResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryColor}"
                                                       Margin="8"/>
                                        </ScrollViewer>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                            </ScrollViewer>
                            </TabItem>

                            <!-- Вкладка "По формуле" -->
                            <TabItem Header="По формуле">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundColor}">
                            <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод формулы -->
                                <GroupBox Grid.Row="0" Header="Формула">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Введите булеву формулу (связь с теплицей):" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBox Text="{Binding BooleanFormula, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontFamily="Consolas" 
                                                 FontSize="12"
                                                 MinHeight="40"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Margin="0,4,0,6"/>
                                        <TextBlock Text="Операторы: !/not (отрицание), &amp;/and (конъюнкция), |/or (дизъюнкция), ^/xor (исключающее ИЛИ), -&gt; (импликация), = (эквивалентность)" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   TextWrapping="Wrap"/>
                                        
                                        <!-- Кнопки с примерами формул для теплицы -->
                                        <TextBlock Text="Примеры формул для теплицы:" Style="{StaticResource HeaderTextStyle}" Margin="0,8,0,6"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,6">
                                            <Button Content="Вентиляция: (x1 | x2)" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="(x1 | x2)"
                                                    Padding="8,6"
                                                    FontSize="11"
                                                    Margin="2"/>
                                            <Button Content="Полив: x1 &amp; !x2" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="x1 &amp; !x2"
                                                    Padding="8,6"
                                                    FontSize="11"
                                                    Margin="2"/>
                                            <Button Content="Импликация: (x1 | x2) -&gt; x3" 
                                                    Command="{Binding LoadExampleFormulaCommand}"
                                                    CommandParameter="(x1 | x2) -&gt; x3"
                                                    Padding="8,6"
                                                    FontSize="11"
                                                    Margin="2"/>
                                        </UniformGrid>
                                        
                                        <TextBlock Text="Где: x1=высокая температура, x2=высокий CO₂, x3=включить вентиляцию" 
                                                   FontSize="10" 
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   FontStyle="Italic"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопка разбора -->
                                <GroupBox Grid.Row="1" Header="Действия">
                                    <StackPanel Margin="8">
                                        <Button Content="Разобрать и вычислить" 
                                                Command="{Binding ParseAndEvaluateFormulaCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Информация о формуле -->
                                <GroupBox Grid.Row="2" Header="Информация о формуле">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding BooleanFormulaInfo}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding BooleanFormulaCost}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentColor}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Результаты -->
                                <GroupBox Grid.Row="3" Header="Результаты">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="Скопировать в буфер" 
                                                Command="{Binding CopyBooleanResultCommand}"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,8"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding BooleanFormulaResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryColor}"
                                                       Margin="8"/>
                                        </ScrollViewer>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                            </ScrollViewer>
                            </TabItem>

                            <!-- Вкладка "Сравнение" -->
                            <TabItem Header="Сравнение">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundColor}">
                            <Grid Margin="8" Background="{StaticResource BackgroundColor}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Ввод функций -->
                                <GroupBox Grid.Row="0" Header="Функции для сравнения">
                    <StackPanel Margin="8">
                                        <TextBlock Text="Сравнение логики принятия решений:" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="Проверьте, эквивалентны ли две формулировки логики управления теплицей. Например, сравните прямую формулу с её DNF-представлением." 
                                                   TextWrapping="Wrap" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   Margin="0,4,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,0">
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Функция 1 (номер или формула):" Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBox Text="{Binding BooleanCompareFunction1, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontFamily="Consolas" 
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Margin="0,4,0,4"/>
                                                <TextBlock Text="Пример: 11 или (x1 &amp; !x2) | x3" 
                                                           FontSize="10" 
                                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="Функция 2 (номер или формула):" Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBox Text="{Binding BooleanCompareFunction2, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontFamily="Consolas" 
                                                         FontSize="11"
                                                         MinHeight="60"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Margin="0,4,0,4"/>
                                                <TextBlock Text="Пример: DNF от функции 1" 
                                                           FontSize="10" 
                                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Кнопка сравнения -->
                                <GroupBox Grid.Row="1" Header="Действия">
                                    <StackPanel Margin="8">
                                        <Button Content="Эквивалентны?" 
                                                Command="{Binding CheckEquivalenceCommand}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Результат сравнения -->
                                <GroupBox Grid.Row="2" Header="Результат сравнения">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="{Binding BooleanEquivalenceResult}" 
                                                       TextWrapping="Wrap" 
                                                       FontFamily="Consolas" 
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                    </StackPanel>
                </ScrollViewer>
                                </GroupBox>
                            </Grid>
                            </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryColor}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentTime, StringFormat='Время: {0:HH:mm:ss}'}" Foreground="{StaticResource TextSecondaryColor}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>